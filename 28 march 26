import java.util.*;

class Solution {
    int count = 0;

    public int totalNumbers(int[] digits) {
        Arrays.sort(digits); // helps avoid duplicates
        boolean[] used = new boolean[digits.length];

        solve(digits, used, "", 0);

        return count;
    }

    void solve(int[] digits, boolean[] used, String curr, int len) {
        if (len == 3) {
            int num = Integer.parseInt(curr);
            if (num % 2 == 0) count++; // check even
            return;
        }

        for (int i = 0; i < digits.length; i++) {

            if (used[i]) continue;

            // skip duplicates
            if (i > 0 && digits[i] == digits[i - 1] && !used[i - 1]) continue;

            // no leading zero
            if (len == 0 && digits[i] == 0) continue;

            used[i] = true;

            solve(digits, used, curr + digits[i], len + 1);

            used[i] = false; // backtrack
        }
    }
}
